-    if (base_x) *base_x = (int)di.display_x + (ws_local_viewport_slot ? src_w : 0);
-    if (source_w) *source_w = src_w;
-    if (wide_w) *wide_w = final_w;
-    if (offset) *offset = off;
-    return final_w > src_w && off > 0;
