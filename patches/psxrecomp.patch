-        for (uint64_t s = oldest; s < total; s++) {
-            const SregTraceEntry *e = &s_sreg_trace[s % SREG_TRACE_CAP];
-            if (e->seq != s) continue;
-            if (has_tcb && e->tcb != tcb_filter) continue;
