+/* Normalized verb: disarm every range in one shot. Parity with
+ * psx-beetle's wtrace_disarm_all. */
+static void handle_wtrace_disarm_all(int id, const char *json)
+{
+    (void)json;
+    s_wtrace_range_count = 0;
+    send_ok(id);
+}
