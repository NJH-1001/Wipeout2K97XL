+            "\"s1\":\"0x%08X\",\"s2\":\"0x%08X\",\"a0\":\"0x%08X\",\"a1\":\"0x%08X\",\"frame\":%u,"
+            "\"stk\":[\"0x%08X\",\"0x%08X\",\"0x%08X\",\"0x%08X\","
+            "\"0x%08X\",\"0x%08X\",\"0x%08X\",\"0x%08X\","
+            "\"0x%08X\",\"0x%08X\"]}",
