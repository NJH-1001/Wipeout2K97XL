-        if (slot < 0) {
-            if (distinct >= max_addrs) {
-                overflow = 1;
-                continue;
-            }
-            slot = distinct++;
-            sum[slot].used = 1;
-            sum[slot].addr = e->addr;
-            sum[slot].first_seq = e->seq;
-            sum[slot].first_new = e->new_val;
-            sum[slot].first_pc = e->pc;
-            sum[slot].first_ra = e->ra;
-            sum[slot].first_func = e->func_addr;
