+/* Presentation metadata only. Row validity prevents partial loading updates
+ * from inventing a background for rows that were never cleared. */
+typedef struct { uint32_t row[512]; } GpuClearBackground;
+static inline void gpu_clear_background_note(GpuClearBackground *b,unsigned y,unsigned h,uint16_t color) {
+    for(unsigned i=0;i<h && i<512;++i)b->row[(y+i)&511]=0x10000u|color;
+}
