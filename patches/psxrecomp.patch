+    if (n < 0) { send_err(id, "census dump: cannot open file"); return; }
+    send_fmt("{\"id\":%d,\"ok\":true,\"rows\":%d,\"path\":\"%s\",\"seq\":%llu}",
+             id, n, path, (unsigned long long)gpu_ws_census_seq());
