+    X(vram_write_x) X(vram_write_y) X(vram_write_w) X(vram_write_h) \
+    X(vram_write_col) X(vram_write_row) X(vram_write_remaining) \
+    X(vram_read_active) X(vram_read_x) X(vram_read_y) X(vram_read_w) X(vram_read_h) \
