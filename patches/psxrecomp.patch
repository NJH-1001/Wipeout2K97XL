+/* Reports the current pad word(s) and any active input override. `pad` is
+ * slot 0 (kept for back-compat); slot0/slot1 report both ports' button word. */
+extern uint16_t sio_get_pad_buttons(void);
+extern uint16_t sio_get_pad_buttons_slot(int slot);
+extern int sio_get_pad_connected(int slot);
+extern int sio_get_pad_analog(int slot);
+extern void sio_get_pad_sticks(int slot, uint8_t out[4]);
+static struct { int kind, opened; char guid[33]; } s_host_pad[5];
+static int s_host_pad_count;
+void debug_server_set_host_pad(int slot, int kind, int opened, const char *guid)
+{
+    if (slot < 0 || slot >= 5) return;
+    s_host_pad[slot].kind = kind;
+    s_host_pad[slot].opened = opened;
+    int n = 0;
+    for (const char *p = guid; p && *p && n < 32; ++p) {
+        if ((*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f') ||
+            (*p >= 'A' && *p <= 'F')) s_host_pad[slot].guid[n++] = *p;
+    }
+    s_host_pad[slot].guid[n] = 0;
+    if (slot >= s_host_pad_count) s_host_pad_count = slot + 1;
+}
+static void handle_host_pad_status(int id, const char *json)
+{
+    (void)json;
+    /* Five slots, 32 hex GUID characters each: bounded well below 1024 bytes. */
+    char response[1024];
+    size_t used = (size_t)snprintf(response, sizeof(response),
+                                  "{\"id\":%d,\"ok\":true,\"slots\":[", id);
+    for (int i = 0; i < s_host_pad_count; ++i) {
+        used += (size_t)snprintf(response + used, sizeof(response) - used,
+                 "%s{\"slot\":%d,\"kind\":%d,\"opened\":%s,\"guid\":\"%s\"}",
+                 i ? "," : "", i, s_host_pad[i].kind,
+                 s_host_pad[i].opened ? "true" : "false", s_host_pad[i].guid);
+    }
+    send_fmt("%s]}\n", response);
+}
