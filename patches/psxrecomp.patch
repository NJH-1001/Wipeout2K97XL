-            int src_y = (gp0_cmd_buf[1] >> 16) & 0x1FF;
-            int dst_x = gp0_cmd_buf[2] & 0x3FF;
-            int dst_y = (gp0_cmd_buf[2] >> 16) & 0x1FF;
