-    int distinct = 0;
-    int overflow = 0;
-    for (uint32_t i = 0; i < s_wtrace_boot_count; i++) {
-        WriteTraceEntry *e = &s_wtrace_boot[i];
-        if (e->addr < filter_lo || e->addr >= filter_hi) continue;
