+                        e->addr, e->val, (unsigned)e->width,
+                        e->func, e->pc, e->frame, e->i_stat,
+                        e->index_reg, e->stat_reg, e->request_reg, e->irq_enable, e->irq_flag,
+                        e->mode_reg,
