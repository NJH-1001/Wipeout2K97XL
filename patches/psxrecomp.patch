+             (m0[0] >= 0x20 && m0[0] < 0x7F) ? m0[0] : '?',
+             (m0[1] >= 0x20 && m0[1] < 0x7F) ? m0[1] : '?',
+             m0[0], m0[1],
+             pres1 ? "true" : "false", dirty1 ? "true" : "false", p1_json,
+             (m1[0] >= 0x20 && m1[0] < 0x7F) ? m1[0] : '?',
