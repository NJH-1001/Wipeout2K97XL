-                        e->start_addr, e->final_addr,
-                        e->requested_words, e->moved_words,
-                        e->bcr, e->chcr, e->dpcr,
-                        e->dicr_start, e->dicr_end,
-                        e->i_stat_start, e->i_stat_end,
-                        e->func, e->pc,
