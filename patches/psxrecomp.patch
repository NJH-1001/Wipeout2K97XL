-{
-    switch (func) {
-        case 0x800171D4u:
-        case 0x8001A51Cu:
-        case 0x8001A670u:
-        case 0x8001A774u:
-        case 0x8001A954u:
-        case 0x8001CE80u:
-        case 0x8001DE24u:
-        case 0x80021C24u:
-        case 0x80021CC8u:
-        case 0x800222B8u:
-        case 0x800223E0u:
-        case 0x8005B40Cu:
-            return 1;
-        default:
-            return 0;
-    }
-}
