+    fputc('[', f);
+    int first = 1;
+    for (uint64_t fr = start; fr < total; fr++) {
+        uint32_t idx = (uint32_t)(fr % FRAME_HISTORY_CAP);
+        const PSXFrameRecord *r = &s_frame_history[idx];
