+"""Copy setup SDK source trees with identical exclusions on every host."""
+import argparse
+import fnmatch
+import pathlib
+import shutil
+
+
+def copy_tree(source, destination, patterns):
+    source = pathlib.Path(source).resolve()
+    destination = pathlib.Path(destination).resolve()
+    if source == destination or source in destination.parents:
+        raise ValueError("Destination must be outside the source tree")
+
+    def ignore(directory, names):
+        relative = pathlib.Path(directory).relative_to(source)
+        ignored = []
+        for name in names:
+            candidate = (relative / name).as_posix()
+            if any(fnmatch.fnmatchcase(candidate if "/" in pattern else name, pattern)
+                   for pattern in patterns):
+                ignored.append(name)
+        return ignored
+
+    shutil.copytree(source, destination, ignore=ignore, dirs_exist_ok=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source")
+    parser.add_argument("destination")
+    parser.add_argument("--exclude", action="append", default=[])
+    args = parser.parse_args()
+    copy_tree(args.source, args.destination, args.exclude)
+
+
+if __name__ == "__main__":
+    main()
