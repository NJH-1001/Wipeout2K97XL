+diff --git a/src/mips/openbios/kernel/alloc.c b/src/mips/openbios/kernel/alloc.c
+index 2b764c2f..1afcf084 100644
+--- a/src/mips/openbios/kernel/alloc.c
++++ b/src/mips/openbios/kernel/alloc.c
+@@ -334,15 +334,150 @@ static __attribute__((section(".ramtext"))) void *multi_realloc(void *ptr_, size
+     return new_ptr;
+ }
+ 
+-__attribute__((section(".ramtext"))) void *user_malloc(size_t size) { return multi_malloc(size, HEAP_USER); }
+-__attribute__((section(".ramtext"))) void user_free(void *ptr) { multi_free(ptr, HEAP_USER); }
+-__attribute__((section(".ramtext"))) void *user_realloc(void *ptr, size_t size) {
+-    return multi_realloc(ptr, size, HEAP_USER);
++/* User ABI uses size words, not the private kernel free-list format.
++ * Derived from observed service behavior; see the title allocator probe.
++ * Free is deliberately an unconditional header-bit update. */
++#define USER_RAM __attribute__((section(".ramtext")))
++#define USER_END UINT32_C(0xfffffffe)
++static uint32_t *user_break;
++static uintptr_t user_limit;
++static uint32_t user_quantum;
++static uint32_t *user_first;
++static uint32_t *user_cursor;
++static int user_started;
++
++static USER_RAM uint32_t *user_advance(uint32_t *header, uint32_t bytes) {
++    return (uint32_t *)((uintptr_t)header + (bytes & ~3u) + 4u);
+ }
+-__attribute__((section(".ramtext"))) void user_initheap(void *base, size_t size) {
+-    user_heap_head = (empty_block *)ALIGN_TO(base);
+-    user_heap_head->next = &marker;
+-    user_heap_head->size = ALIGN_TO(size - sizeof(empty_block));
++
++static USER_RAM int user_extend(uint32_t request) {
++    uint32_t amount = 0;
++    if (!request) {
++        if (user_limit <= (uintptr_t)user_break) return -1;
++    } else {
++        uint32_t large = request > user_quantum ? request : user_quantum;
++        uint32_t small = request > user_quantum ? user_quantum : request;
++        uint32_t available = ((user_limit - (uintptr_t)user_break) & ~3u) - 4u;
++        amount = large;
++        if (available < large) {
++            if (available < small) return -1;
++            amount = small;
++        }
++    }
++    *(uint32_t *)((uintptr_t)user_break + (amount & ~3u)) = USER_END;
++    user_break[-1] = amount | 1u;
++    user_break = (uint32_t *)((uintptr_t)user_break + ((amount + 4u) & ~3u));
++    return 0;
++}
++
++USER_RAM void user_initheap(void *base, size_t size) {
++    user_break = base;
++    *user_break = 0;
++    user_limit = (uintptr_t)base + (size & ~3u) + 4u;
++    user_quantum = size;
++    user_started = 0;
++}
++
++USER_RAM void *user_malloc(size_t size) {
++    uint32_t request = (size + 3u) & ~3u;
++    int scans = 2;
++    if (!user_started) {
++        if (user_limit <= (uintptr_t)user_break) return NULL;
++        *user_break = USER_END;
++        user_cursor = user_break++;
++        if (user_extend(request)) return NULL;
++        user_first = user_cursor;
++        user_started = 1;
++    }
++    for (;;) {
++        uint32_t header = *user_cursor;
++        if (!(header & 1u)) {
++            if (header != USER_END) {
++                user_cursor = user_advance(user_cursor, header);
++            } else if (--scans > 0) {
++                user_cursor = user_first;
++            } else if (user_extend(request)) {
++                /* The sentinel path exposes the extension failure word. */
++                return (void *)(uintptr_t)UINT32_MAX;
++            }
++            continue;
++        }
++        if (header == (request | 1u)) {
++            *user_cursor &= ~1u;
++            return user_cursor + 1;
++        }
++        if (header > (request | 1u)) {
++            *user_advance(user_cursor, request) = header - request - 4u;
++            *user_cursor = request;
++            return user_cursor + 1;
++        }
++        uint32_t *next = user_advance(user_cursor, header);
++        if (*next == USER_END) {
++            if (--scans > 0) user_cursor = user_first;
++            else if (user_extend(request)) return NULL;
++        } else if (*next & 1u) {
++            *user_cursor += (*next & ~1u) + 4u;
++        } else {
++            user_cursor = next;
++        }
++    }
++}
++
++USER_RAM void user_free(void *ptr) {
++    ((volatile uint32_t *)ptr)[-1] |= 1u;
++}
++
++static USER_RAM void *user_resize(void *ptr, uint32_t request) {
++    uint32_t *header = (uint32_t *)ptr - 1;
++    if (*header == USER_END) return NULL;
++    uint32_t capacity = *header & ~1u;
++    uint32_t *following = header;
++    while (capacity < request) {
++        following = user_advance(following, *following);
++        uint32_t next_size = *following;
++        if (next_size == USER_END) {
++            uint32_t extra = request - capacity;
++            /* Preserve the reference's word-count capacity check and its
++             * payload-only merge (including its observable realloc defect). */
++            uint32_t available = (uint32_t)((int32_t)(user_limit - (uintptr_t)following) >> 2) - 4u;
++            if (available < extra) break;
++            *(uint32_t *)((uintptr_t)following + (extra & ~3u)) = USER_END;
++            *following = extra | 1u;
++            next_size = *following;
++        } else if (!(next_size & 1u)) {
++            break;
++        }
++        *header += next_size & ~1u;
++        capacity += next_size & ~1u;
++    }
++    capacity = *header & ~1u;
++    if (request < (*header & ~3u)) {
++        *user_advance(header, request) = (capacity - request - 4u) | 1u;
++        *header = request | (*header & 1u);
++    } else if (capacity < request) {
++        return NULL;
++    }
++    return ptr;
++}
++
++USER_RAM void *user_realloc(void *ptr, size_t size) {
++    if (!ptr) return user_malloc(size);
++    if (!size) {
++        user_free(ptr);
++        /* Reference return is unspecified on this path. */
++        return NULL;
++    }
++    void *result = user_resize(ptr, (size + 3u) & ~3u);
++    if (result) return result;
++    result = user_malloc(size);
++    if (result) {
++        /* The BIOS copies the requested count, not the old payload size. */
++        unsigned char *dst = result;
++        const unsigned char *src = ptr;
++        for (size_t i = 0; i < size; ++i) dst[i] = src[i];
++        user_free(ptr);
++    }
++    return result;
+ }
+ 
+ __attribute__((section(".ramtext"))) void *kern_malloc(size_t size) { return multi_malloc(size, HEAP_KERNEL); }
diff --git a/runtime/include/beetle_cycle_watch.h b/runtime/include/beetle_cycle_watch.h
new file mode 100644
index 00000000..86be9ead
--- /dev/null
+++ b/runtime/include/beetle_cycle_watch.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <cstdint>
+struct BeetleCycleWatch {
+    static constexpr uint32_t capacity = 1024;
+    struct Entry { uint32_t pc; uint64_t cycles; } entries[capacity]{};
+    uint32_t anchor = 0, end = 0, max_hits = 16, hits = 0;
+    bool armed = false, in_region = false;
+    uint64_t start = 0;
+    void clear() { armed = false; hits = 0; in_region = false; }
+    void arm(uint32_t a, uint32_t b, int n) {
+        clear(); anchor = a; end = b;
+        max_hits = n <= 0 ? 16 : (uint32_t)n > capacity ? capacity : (uint32_t)n;
+        armed = true;
+    }
+    void observe(uint32_t pc, uint64_t cycles) {
+        if (!armed) return;
+        pc &= 0x1FFFFFFFu;
+        if ((end & 0x1FFFFFFFu) != 0) {
+            if (!in_region) {
+                if (pc == (anchor & 0x1FFFFFFFu)) { start = cycles; in_region = true; }
+                return;
+            }
+            if (pc != (end & 0x1FFFFFFFu)) return;
+            cycles -= start;
+            in_region = false;
+        } else if (pc != (anchor & 0x1FFFFFFFu)) return;
+        entries[hits++] = {pc, cycles};
+        if (hits >= max_hits) armed = false;
+    }
+};
