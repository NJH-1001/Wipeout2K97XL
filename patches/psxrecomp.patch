+static uint32_t call_focus_object_ptr(uint32_t func, CPUState *cpu)
+{
+    if (!cpu) return 0;
+    switch (func) {
+        case 0x80068AA8u:
+        case 0x80068DDCu:
+        case 0x80068E5Cu:
+            return 0x8009B3A0u + ((cpu->gpr[4] & 0x00F0u) ? 0xF0u : 0u);
+        case 0x8006A0C0u:
+        case 0x8006A128u:
+        case 0x8006A144u:
+        case 0x8006A378u:
+        case 0x8006A38Cu:
+        case 0x8006A3CCu:
