+    send_fmt("{\"id\":%d,\"ok\":true,"
+             "\"slot0\":{\"present\":%s,\"dirty\":%s,\"path\":\"%s\","
+             "\"magic\":\"%c%c\",\"magic_hex\":\"%02X%02X\"},"
