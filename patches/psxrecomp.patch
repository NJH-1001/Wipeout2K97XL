--- /dev/null
+++ b/runtime/include/ws_hud_packet.h
@@ -0,0 +1,44 @@
+/* Presentation metadata only. Payload guards prevent recycled packets from
+ * inheriting another draw's anchor. A collision fails closed. */
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#define WS_HUD_PACKET_SLOTS 2048u
+typedef struct WsHudPacket {
+    uint32_t key;
+    uint32_t words[9];
+    int anchor;
+} WsHudPacket;
+static inline void ws_hud_packet_set(WsHudPacket *table, uint32_t address,
+                                      const uint32_t *words, int anchor) {
+    uint32_t key = address & 0x1fffffffu;
+    if ((key & 3u) || key < 4u || key > 0x1fffdcu) return;
+    uint32_t start = (key >> 2) & (WS_HUD_PACKET_SLOTS - 1u);
+    WsHudPacket *t = 0;
+    for (unsigned i=0;i<32u;++i) {
+        WsHudPacket *slot=&table[(start+i)&(WS_HUD_PACKET_SLOTS-1u)];
+        if (slot->key==key) { t=slot; break; }
+        if (!slot->key && !t) t=slot;
+    }
+    if (!t) return;
+    /* Clear only this packet's owner; unrelated colliding packets survive. */
+    if (t->key==key) t->key=0;
+    if (!words || (anchor != -1 && anchor != 1) ||
+        ((words[0] >> 24) & 0xfcu) != 0x2cu) return;
+    t->key = key;
+    memcpy(t->words, words, sizeof(t->words));
+    t->anchor = anchor;
+}
+static inline int ws_hud_packet_anchor(const WsHudPacket *table,
+                                       uint32_t address, const uint32_t *words) {
+    uint32_t key = address & 0x1fffffffu;
+    if (address == 0xffffffffu || (key & 3u) || key < 4u || key > 0x1fffdcu)
+        return 0;
+    uint32_t start=(key>>2)&(WS_HUD_PACKET_SLOTS-1u);
+    for (unsigned i=0;i<32u;++i) {
+        const WsHudPacket *t=&table[(start+i)&(WS_HUD_PACKET_SLOTS-1u)];
+        if (t->key==key)
+            return memcmp(t->words,words,sizeof(t->words))==0 ? t->anchor : 0;
+    }
+    return 0;
+}
