-    send_fmt("{\"id\":%d,\"ok\":true,\"armed\":%s,"
-             "\"lo\":\"0x%08X\",\"hi\":\"0x%08X\","
-             "\"excl\":\"0x%08X\","
-             "\"valid\":%d,\"pc\":\"0x%08X\",\"insn\":\"0x%08X\","
-             "\"s3_old\":\"0x%08X\",\"s3_new\":\"0x%08X\","
