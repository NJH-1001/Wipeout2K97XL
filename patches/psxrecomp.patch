+static void handle_wtrace_all_reset(int id, const char *json)
+{
+    (void)json;
+    s_wtrace_all_seq = 0;
+    s_wtrace_all_head = 0;
+    if (s_wtrace_all)
+        memset(s_wtrace_all, 0,
+               (size_t)WRITE_TRACE_ALL_CAP * sizeof(WriteTraceAllEntry));
+    send_ok(id);
