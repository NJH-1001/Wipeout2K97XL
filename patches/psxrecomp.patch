-    if (window > 80) window = 80;
-
-    uint64_t found = (uint64_t)-1;
-    if (newest_first) {
-        for (uint64_t s = total; s > oldest; ) {
-            s--;
-            const SregTraceEntry *e = &s_sreg_trace[s % SREG_TRACE_CAP];
-            if (e->seq != s) continue;
