diff --git a/runtime/tests/test_beetle_cycle_watch.cpp b/runtime/tests/test_beetle_cycle_watch.cpp
new file mode 100644
index 00000000..576c3e17
--- /dev/null
+++ b/runtime/tests/test_beetle_cycle_watch.cpp
@@ -0,0 +1,22 @@
+#include "beetle_cycle_watch.h"
+#include <cstdlib>
+static void require(bool value) { if (!value) std::abort(); }
+int main() {
+    BeetleCycleWatch w;
+    w.arm(0x80001000, 0, 2);
+    w.observe(0x1004, 10); require(w.hits == 0);
+    w.observe(0xA0001000, 11); w.observe(0x1000, 20);
+    require(w.hits == 2 && !w.armed && w.entries[0].cycles == 11 && w.entries[1].cycles == 20);
+    w.observe(0x1000, 30); require(w.hits == 2);
+    w.arm(0x1000, 0x80002000, 1);
+    w.observe(0x2000, 40); w.observe(0x1000, 50); w.observe(0x1000, 55);
+    w.observe(0x2000, 80);
+    require(w.hits == 1 && w.entries[0].cycles == 30 && w.entries[0].pc == 0x2000);
+    w.arm(0x1000, 0x1000, 1); w.observe(0x1000, 100); w.observe(0x1000, 140);
+    require(w.hits == 1 && w.entries[0].cycles == 40);
+    w.arm(0, 0, 999999); require(w.max_hits == w.capacity);
+    for (unsigned i=0; i<w.capacity+10; ++i) w.observe(0, i);
+    require(w.hits == w.capacity && !w.armed);
+    w.arm(0, 0, -1); require(w.max_hits == 16);
+    w.clear(); w.observe(0, 100); require(!w.armed && w.hits == 0);
+}
diff --git a/runtime/tests/test_negcon_protocol.c b/runtime/tests/test_negcon_protocol.c
new file mode 100644
index 00000000..d3a53df4
--- /dev/null
+++ b/runtime/tests/test_negcon_protocol.c
@@ -0,0 +1,46 @@
+#include "negcon_protocol.h"
+#include <string.h>
+
+/* Packet bytes independently captured from Beetle through SIO TCP.
+ * Failure returns a distinct nonzero case; no runtime logging required. */
+int main(void) {
+    static const uint8_t values[5][4] = {
+        {128,0,0,0}, {0,255,0,0}, {255,0,255,0},
+        {128,0,0,255}, {128,64,128,191}
+    };
+    for (int c = 0; c < 5; ++c) {
+        NegconProtocol s = {0};
+        const uint8_t *v = values[c];
+        uint8_t expected[9] = {255,35,90,255,255,v[0],v[1],v[2],v[3]};
+        negcon_select(&s, 1);
+        for (int b = 0; b < 9; ++b) {
+            NegconReply r = negcon_exchange(&s, b == 0 ? 1 : b == 1 ? 0x42 : 0,
+                                             0xFFFF,v[0],v[1],v[2],v[3]);
+            if (r.rx != expected[b]) return 1+c;
+            if (r.ack_cycles != (b < 2 ? 256 : b < 8 ? 128 : 0)) return 10+c;
+        }
+        if (negcon_exchange(&s,1,0,0,0,0,0).ack_cycles) return 20;
+    }
+    NegconProtocol s = {0};
+    if (negcon_exchange(&s,1,0,0,0,0,0).rx != 255) return 21;
+    negcon_select(&s,1);
+    (void)negcon_exchange(&s,1,0,128,0,0,0);
+    NegconReply bad = negcon_exchange(&s,0x43,0,128,0,0,0);
+    if (bad.rx != 0x23 || bad.ack_cycles) return 22;
+    if (negcon_exchange(&s,1,0,0,0,0,0).rx != 255) return 23;
+    negcon_select(&s,0); negcon_select(&s,1);
+    (void)negcon_exchange(&s,1,0,128,0,0,0);
+    (void)negcon_exchange(&s,0x42,0,128,10,20,30);
+    (void)negcon_exchange(&s,0,0,0,0,0,0);
+    NegconProtocol restored;
+    memcpy(&restored,&s,sizeof(s));
+    static const uint8_t tail[6] = {7,199,128,10,20,30};
+    for (int b=0;b<6;++b) {
+        NegconReply r=negcon_exchange(&restored,0,0xFFFF,255,255,255,255);
+        if (r.rx != tail[b]) return 24;
+    }
+    /* Deselect aborts the old packet, including its latched inputs. */
+    negcon_select(&s,0); negcon_select(&s,1);
+    if (negcon_exchange(&s,1,0,0,0,0,0).rx != 255) return 25;
+    return 0;
+}
diff --git a/runtime/tests/test_sio_negcon.c b/runtime/tests/test_sio_negcon.c
new file mode 100644
index 00000000..9117f594
--- /dev/null
+++ b/runtime/tests/test_sio_negcon.c
@@ -0,0 +1,65 @@
+/* Full MMIO path, with packet vectors independently captured from Beetle. */
+#include "sio.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "sio_test_host.h"
+#define DATA 0x1F801040u
+#define CTRL 0x1F80104Au
+#define SELECT 0x1003u
+#define CHECK(x) do { if (!(x)) return __LINE__; } while (0)
+static int step = 2000;
+static void advance(int cycles) {
+    while (cycles) { int n = cycles < step ? cycles : step; sio_tick(n); cycles -= n; }
+}
+static void restart(void) { sio_write(CTRL, 0); sio_write(CTRL, SELECT); }
+static int exchange(uint8_t tx, uint8_t expected, int delay, int save) {
+    i_stat = 0;
+    sio_write(CTRL, SELECT | 0x10);
+    sio_write(DATA, tx);
+    advance(1087);
+    CHECK(!(sio_peek_stat() & 2)); CHECK(!(i_stat & 0x80));
+    advance(1);
+    CHECK(sio_peek_stat() & 2); CHECK(!(i_stat & 0x80));
+    if (save) {
+        uint32_t len = sio_snapshot_bytes(); uint8_t *p = malloc(len);
+        CHECK(p); sio_snapshot_write(p);
+        advance(2000);
+        CHECK(sio_snapshot_read(p, len)); free(p); i_stat = 0;
+    }
+    CHECK((uint8_t)sio_read(DATA) == expected);
+    if (delay) {
+        advance(delay - 1); CHECK(!(i_stat & 0x80));
+        advance(1); CHECK(i_stat & 0x80);
+    } else { advance(512); CHECK(!(i_stat & 0x80)); }
+    return 0;
+}
+int main(int argc, char **argv) {
+    if (argc > 1) { step = atoi(argv[1]); if (step < 1 || step > 2000) return 2; }
+    static const uint8_t vectors[][4] = {
+        {128,0,0,0}, {0,255,0,0}, {255,0,255,0}, {128,0,0,255}, {128,64,128,191}
+    };
+    sio_init(); sio_connect_pad(0); CHECK(sio_set_pad_negcon(0));
+    CHECK(sio_get_pad_negcon(0)); CHECK(!sio_get_pad_analog(0));
+    for (unsigned v = 0; v < sizeof(vectors)/sizeof(vectors[0]); ++v) {
+        const uint8_t *a = vectors[v];
+        sio_set_pad_state_slot(0, 0xFFF7);
+        sio_set_pad_negcon_input(0,a[0],a[1],a[2],a[3]);
+        /* DualShock host maintenance must not mutate a different device. */
+        sio_set_pad_sticks(0,1,2,3,4); sio_request_pad_type(0,1);
+        restart();
+        CHECK(!exchange(1,0xFF,256,1)); CHECK(!exchange(0x42,0x23,256,1));
+        sio_set_pad_negcon_input(0,55,66,77,88);
+        sio_set_pad_state_slot(0,0xFFFF);
+        const uint8_t packet[] = {0x5A,0xF7,0xFF,a[0],a[1],a[2],a[3]};
+        for (unsigned b=0;b<7;++b) CHECK(!exchange(0,packet[b],b==6?0:128,1));
+        CHECK(!exchange(1,0xFF,0,0)); /* DTR edge is required. */
+    }
+    restart(); CHECK(!exchange(2,0xFF,0,0)); CHECK(!exchange(1,0xFF,0,0));
+    restart(); CHECK(!exchange(1,0xFF,256,0));
+    CHECK(!exchange(0x43,0x23,0,0)); CHECK(!exchange(0,0xFF,0,0));
+    /* Return to a digital device at a released bus boundary. */
+    sio_write(CTRL,0); sio_set_pad_analog(0,0,128,128,128,128);
+    restart(); CHECK(!exchange(1,0xFF,170,0)); CHECK(!exchange(0x42,0x41,170,0));
+    return 0;
+}
diff --git a/tools/copy_setup_source_tree.py b/tools/copy_setup_source_tree.py
new file mode 100644
index 00000000..45b551ac
