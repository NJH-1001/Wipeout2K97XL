diff --git a/runtime/include/negcon_protocol.h b/runtime/include/negcon_protocol.h
new file mode 100644
index 00000000..6d1e18ea
--- /dev/null
+++ b/runtime/include/negcon_protocol.h
@@ -0,0 +1,68 @@
+#ifndef PSXRECOMP_NEGCON_PROTOCOL_H
+#define PSXRECOMP_NEGCON_PROTOCOL_H
+#include <stdint.h>
+
+/* SDL/libretro normalized input to the eight-bit physical controls. */
+static inline uint8_t negcon_twist_byte(int value) {
+    if (value < -32767) value = -32767;
+    if (value > 32767) value = 32767;
+    int position = value < 0 ? 32768 - ((-value * 32768 + 16383) / 32767)
+                             : 32768 + value;
+    return (uint8_t)((position * 255 + 32767) / 65535);
+}
+static inline uint8_t negcon_pressure_byte(int value) {
+    if (value < 0) value = 0;
+    if (value > 32767) value = 32767;
+    return (uint8_t)((value * 255 + 16383) / 32767);
+}
+
+/* Byte boundary device model. ACK delays are guest CPU clocks after the
+ * completed byte, as in Beetle input/negcon.cpp. The SIO bus owns bit shifting.
+ * State is byte-only, explicit and portable for snapshot serialization.
+ * phase: 0 address, 1 command, 2 response, 3 deselect required. */
+typedef struct {
+    uint8_t selected, phase, next, response[7];
+} NegconProtocol;
+typedef struct { uint8_t rx; uint16_t ack_cycles; } NegconReply;
+
+static inline void negcon_select(NegconProtocol *s, int selected) {
+    if (!s->selected && selected) {
+        s->phase = 0;
+        s->next = 0;
+    }
+    s->selected = selected ? 1 : 0;
+}
+
+static inline NegconReply negcon_exchange(NegconProtocol *s, uint8_t tx,
+        uint16_t buttons, uint8_t twist, uint8_t i, uint8_t ii, uint8_t l) {
+    NegconReply r = { 0xFF, 0 };
+    if (!s->selected) return r;
+    if (s->phase == 0) {
+        s->phase = tx == 0x01 ? 1 : 3;
+        if (s->phase == 1) r.ack_cycles = 256;
+    } else if (s->phase == 1) {
+        r.rx = 0x23;
+        s->phase = 3;
+        if (tx == 0x42) {
+            /* Unwired digital bits remain released. Defined buttons are
+             * Start, directions, A, B and R (active low). */
+            buttons |= (uint16_t)~0x38F8u;
+            s->response[0] = 0x5A;
+            s->response[1] = (uint8_t)buttons;
+            s->response[2] = (uint8_t)(buttons >> 8);
+            s->response[3] = twist;
+            s->response[4] = i;
+            s->response[5] = ii;
+            s->response[6] = l;
+            s->next = 0;
+            s->phase = 2;
+            r.ack_cycles = 256;
+        }
+    } else if (s->phase == 2 && s->next < 7) {
+        r.rx = s->response[s->next++];
+        if (s->next < 7) r.ack_cycles = 128;
+        else s->phase = 3;
+    }
+    return r;
+}
+#endif
diff --git a/runtime/src/mod_gpu_memory.c.inc b/runtime/src/mod_gpu_memory.c.inc
new file mode 100644
index 00000000..551ab285
--- /dev/null
+++ b/runtime/src/mod_gpu_memory.c.inc
@@ -0,0 +1,57 @@
+/* Shared aperture storage implementation, also exercised by the standalone test. */
+static uint8_t mod_gpu_dma_memory[PSX_MOD_GPU_DMA_APERTURE_SIZE];
+static uint32_t mod_gpu_dma_memory_used;
+typedef struct { uint32_t word; int32_t x16,y16; uint32_t valid; } ModVertex;
+static ModVertex *mod_vertices;
+static uint32_t mod_vertex_hits;
+uint32_t psx_mod_gpu_vertex_hits(void) { return mod_vertex_hits; }
+static void mod_vertex_invalidate(uint32_t off, uint32_t bytes) {
+    if (mod_vertices) for (uint32_t i=off/4;i<=(off+bytes-1)/4;++i)
+        mod_vertices[i].valid=0;
+}
+
+
+uint32_t psx_mod_gpu_dma_memory_alloc(uint32_t size, uint32_t alignment) {
+    uint32_t start;
+    if (size == 0u) return 0u;
+    if (alignment == 0u) alignment = 1u;
+    if ((alignment & (alignment - 1u)) != 0u || alignment > 4096u) return 0u;
+    start = (mod_gpu_dma_memory_used + alignment - 1u) & ~(alignment - 1u);
+    if (start > PSX_MOD_GPU_DMA_APERTURE_SIZE ||
+        size > PSX_MOD_GPU_DMA_APERTURE_SIZE - start)
+        return 0u;
+    memset(mod_gpu_dma_memory + start, 0, size);
+    mod_gpu_dma_memory_used = start + size;
+    return PSX_MOD_GPU_DMA_GUEST_BASE + start;
+}
+
+static int mod_gpu_dma_memory_offset(uint32_t phys, uint32_t width,
+                                     uint32_t *offset) {
+    return psx_mod_gpu_dma_aperture_offset_for(
+        phys, width, mod_gpu_dma_memory_used, offset);
+}
+
+int psx_mod_gpu_vertex_set(uint32_t address,uint32_t word,int32_t x16,int32_t y16) {
+    uint32_t off, actual;
+    if ((address&3u) || !mod_gpu_dma_memory_offset(address&0x1fffffffu,4,&off)) return 0;
+    mod_vertex_invalidate(off,4);
+    memcpy(&actual,mod_gpu_dma_memory+off,4);
+    if (actual!=word || x16 < -1024*65536 || x16 >= 1024*65536 ||
+        y16 < -1024*65536 || y16 >= 1024*65536) return 0;
+    if (!mod_vertices) mod_vertices=(ModVertex*)calloc(PSX_MOD_GPU_DMA_APERTURE_SIZE/4,sizeof(ModVertex));
+    if (!mod_vertices) return 0;
+    mod_vertices[off/4]=(ModVertex){word,x16,y16,1};return 1;
+}
+int psx_mod_gpu_vertex_get(uint32_t address,uint32_t word,int32_t *x16,int32_t *y16) {
+    uint32_t off;
+    if (!mod_vertices || (address&3u) || !mod_gpu_dma_memory_offset(address&0x1fffffffu,4,&off)) return 0;
+    const ModVertex *v=&mod_vertices[off/4];
+    if (!v->valid || v->word!=word) return 0;
+    *x16=v->x16;*y16=v->y16;++mod_vertex_hits;return 1;
+}
+
+uint32_t psx_mod_gpu_dma_resolve_address(uint32_t address) {
+    return psx_mod_gpu_dma_resolve_address_for(
+        address, mod_gpu_dma_memory_used);
+}
+
